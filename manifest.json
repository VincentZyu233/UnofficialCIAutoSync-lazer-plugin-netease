{
  "id": "lazer.netease",
  "name": "网易云音乐",
  "version": "1.0.1",
  "description": "网易云音乐 Lua Gateway，支持登录、搜索、歌单、歌词、音频流和播放统计。",
  "author": "Illusion",
  "entry": "main.lua",
  "apiVersion": 1,
  "provider": "netease",
  "capabilities": [
    "search",
    "browseAlbums",
    "playlists",
    "editPlaylists",
    "favorites",
    "lyrics",
    "scrobble",
    "recommendations",
    "savedAlbums",
    "comments",
    "listenTogether",
    "radio",
    "charts",
    "homeFeed"
  ],
  "auth": [
    "qr",
    "sms",
    "password",
    "cookie",
    "exportCookie"
  ],
  "permissions": {
    "network": [
      "music.163.com",
      "interfacepc.music.163.com",
      "clientlog.music.163.com"
    ],
    "storage": true
  }
}